version: '3.8'

services:
  db:
    image: postgres:15
    environment:
      POSTGRES_DB: univ_db
      POSTGRES_USER: univ_user
      POSTGRES_PASSWORD: your_secure_password_here  # ← не 1234!
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U univ_user -d univ_db"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"  # опционально, для локального доступа

  backend:
    build: ./backend
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgresql://univ_user:your_secure_password_here@db:5432/univ_db
      SECRET_KEY: your-super-secret-key-change-in-production
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    volumes:
      - ./frontend:/workspace/frontend  # Mount the frontend source code for development
    volumes:
      # Mount a volume for service account key if needed
      # - ./credentials.json:/app/credentials.json:ro
      - ./backend:/workspace/backend  # Mount the backend source code for development

  frontend:
    build: 
      context: ./frontend
      dockerfile: Dockerfile
    ports:
      - "3000:3000"
    depends_on:
      - backend
    restart: unless-stopped
    volumes:
      - ./frontend:/workspace/frontend  # Mount the frontend source code for development
    volumes:
      # Mount a volume for service account key if needed
      # - ./credentials.json:/app/credentials.json:ro
      - ./backend:/workspace/backend  # Mount the backend source code for development

volumes:
  postgres_data: